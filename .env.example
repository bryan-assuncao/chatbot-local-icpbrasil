# Copie para .env e ajuste conforme necessário. Todos os valores são opcionais.

# Ollama
OLLAMA_URL=http://localhost:11434
ICP_LLM_MODEL=gemma3:12b
ICP_TEMPERATURE=0.0
ICP_REQUEST_TIMEOUT=300
ICP_CONTEXT_WINDOW=8192

# Documentos e índice
ICP_DATA_DIR=data
ICP_PERSIST_DIR=chroma_db
ICP_COLLECTION=icp_brasil_docs

# Busca (alterar embeddings ou chunks força a reindexação completa)
ICP_EMBED_MODEL=intfloat/multilingual-e5-large
ICP_CHUNK_SIZE=400
ICP_CHUNK_OVERLAP=60
ICP_TOP_K=8
